# DigiWP server (the واسط) configuration
PORT=8787

# Secret for signing hub session tokens (CHANGE in production).
AUTH_SECRET=dev-only-change-me

# Allowed hub origin for CORS (the hub's URL). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
DATABASE_URL=postgres://digiwp:digiwp@localhost:5432/digiwp

# Public base URL of THIS server's API as reachable from the internet
# (e.g. https://hub.example.com/api). Used for the pairing serverUrl.
# PUBLIC_BASE_URL=

# When 1, per-site reads/actions relay to the live connector on each paired site.
LIVE=0

# Telegram daily security digest (optional). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hour of day (UTC, 0–23) to send the daily digest.
DIGEST_HOUR=8

# --- Assistant model (optional) ---
#
# Any OpenAI-compatible endpoint. Without both a URL and a key the assistant
# still answers — from the site's own readings, saying plainly that free-form
# questions are unavailable — but it cannot run the tool loop, so it can
# describe a site and never act on one.
#
# The URL may be written with or without the /v1 suffix; both work.
# ASSISTANT_URL=https://gate.nabuxai.com/v1
# ASSISTANT_API_KEY=
#
# A model the endpoint serves. Against NabuGate this is an alias, not a
# provider model name. The default suits a maintenance question; a model that
# cannot call tools will answer without ever using one.
# ASSISTANT_MODEL=nabu-smart
